# 자동 기록 로그 (질문·세션 hook 기록은 커밋하지 않음 — 폴더 구조만 유지)
logs/*.jsonl
logs/sessions/
logs/sessions.log

# 의존성 (하위 backend/ · frontend/ .gitignore 가 1차로 처리, 안전망)
vendor/
node_modules/

# 환경설정·비밀값 (절대 커밋 금지)
.env
.env.*
!.env.example

# 빌드 산출물
dist/
/build/
backend/public/build/
backend/public/hot
backend/public/storage

# Laravel 런타임 캐시/로그
backend/storage/framework/cache/data/*
backend/storage/logs/*.log
backend/bootstrap/cache/*.php

# OS·에디터
.DS_Store
Thumbs.db
.idea/
.vscode/

# 임시 디버그 스크립트 (공개 제외)
/backend/test_*.php

# 직원 간 기술 핸드오프 문서 — 포폴 공개용이 아니다.
# 실명·공인IP·실계좌·사생활 맥락이 반복해서 유입됐다(2026-07-17 유출 적발).
docs/기능/

# Vercel CLI 프로젝트 링크 폴더 (로컬 전용)
.vercel

# ── 내부 문서·설정 차단 (2026-08-19 신설) ──────────────────────────
# 이 레포는 비공개 모노레포에서 **큐레이션되어** 나온다. 아래는 그 큐레이션이 실수해도
# 커밋 자체가 안 되게 하는 1차 방어선이다. 종전에는 방어가 **pre-push 훅 하나뿐**이라,
# `git add -A` 한 번이면 내부 문서가 커밋까지 성공하고 push 에서만 막혔다
# (그 상태에서 `--no-verify`·`SKIP_NAME_GUARD=1` 로 넘기면 그대로 유출).
# 계기: 2026-08-19 에 `docs/개발/함정.md` 를 신설했는데 그 경로를 막는 줄이 없었다.
docs/개발/
docs/기능/
.claude/
CLAUDE.md
logs/작업일지.md
