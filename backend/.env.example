APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# TiDB Cloud Serverless (MySQL 호환, TLS 필수). host/user는 TiDB 콘솔에서 발급, 비번은 본인이 입력(커밋 금지)
DB_HOST=
DB_PORT=4000
DB_DATABASE=hachiware
DB_USERNAME=
DB_PASSWORD=
# DB_SSL_CA: 주석 처리(키 부재)하면 레포의 tidb-ca.pem(base_path) 자동 사용. 다른 CA 경로를 쓸 때만 값 지정.
#   빈 값(DB_SSL_CA=)으로 두면 SSL 비활성 — 로컬 non-TLS DB에서만 그렇게 한다(TiDB는 TLS 필수).
# DB_SSL_CA=

# 토스증권 Open API — 시세·환율·차트·종목정보 (토스증권 WTS 설정 메뉴에서 발급)
# 값은 비워둠 — 새 머신에서 본인이 직접 입력(비밀값, 절대 커밋 금지)
TOSS_API_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
